# AX Terminal — environment configuration
# Copy this file to .env and fill in your values.
# Place .env in the same folder as ax-terminal.exe (or project root for dev).

# AX-Connect REST API base URL
AX_API_URL=http://localhost:4000

# Optional: pre-authenticated platform JWT token.
# If set, the terminal skips the login prompt at startup.
# Leave blank to be prompted for email/password on launch.
AX_API_TOKEN=
